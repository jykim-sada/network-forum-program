{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/app", "destination": "/app/start" },
    { "source": "/screen", "destination": "/app/screen" },
    { "source": "/admin", "destination": "/app/admin" },
    { "source": "/recorder", "destination": "/app/recorder" },
    { "source": "/phone", "destination": "/app/phone" },
    { "source": "/print", "destination": "/app/print" }
  ],
  "headers": [
    { "source": "/app/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(screen|admin|recorder|phone|print|app)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
